USE_SQLITE=False
DEBUG=False
ORACLE=False

# TROQUE por uma chave longa e aleatória (ex: rode: python -c "import secrets; print(secrets.token_hex(50))")
SECRET_KEY=TROQUE_AQUI_POR_UMA_CHAVE_SECRETA_LONGA

# Coloque seu domínio (sem https://)
ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com
ALLOWED_ORIGIN=https://seu-dominio.com

# Banco de dados PostgreSQL (o DB_HOST deve ser "db", nome do serviço no docker-compose)
DB_NAME=cras_db
DB_USER=cras_user
DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
DB_HOST=db
DB_PORT=5432

# URLs do frontend (substitua pelo seu domínio)
FRONTEND_RESET_PASSWORD_URL=https://seu-dominio.com/sistema/alterar-senha
FRONTEND_SEM_CADASTRO_URL=https://seu-dominio.com/cadastro
FRONTEND_SELO_URL=https://seu-dominio.com/selo
FRONTEND_SUCCESS_URL=https://seu-dominio.com/perfil

# E-mail (opcional, preencha se usar)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SSO (deixe em branco se não usar)
API_URL=
RHSSO_URL_BASE=
CLIENT_ID=
CLIENT_SECRET=
REALM=
USER_KEY=
HOST=seu-dominio.com
SS_EXT=
REDIRECT_URI=https://seu-dominio.com/login-sso
